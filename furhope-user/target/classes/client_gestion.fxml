<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="14" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.esprit.controllers.ClientGestionController"
      stylesheets="@styles.css" styleClass="page">

    <padding>
        <Insets top="18" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Client Gestion - CRUD" styleClass="title"/>

    <FlowPane hgap="10" vgap="10" alignment="CENTER">
        <TextField fx:id="fullNameField" promptText="Full Name" prefWidth="180"/>
        <TextField fx:id="emailField" promptText="Email" prefWidth="180"/>
        <TextField fx:id="phoneField" promptText="Phone" prefWidth="130"/>
        <TextField fx:id="cityField" promptText="City" prefWidth="110"/>
        <ComboBox fx:id="statusCombo" prefWidth="120"/>
    </FlowPane>

    <FlowPane hgap="10" vgap="10" alignment="CENTER">
        <Button text="Add" styleClass="primary-button" prefWidth="100" onAction="#addClient"/>
        <Button text="Update" styleClass="primary-button" prefWidth="100" onAction="#updateClient"/>
        <Button text="Delete" styleClass="secondary-button" prefWidth="100" onAction="#deleteClient"/>
        <Button text="Refresh" styleClass="secondary-button" prefWidth="100" onAction="#refreshTable"/>
        <Button text="Back" styleClass="secondary-button" prefWidth="100" onAction="#goBack"/>
    </FlowPane>

    <ListView fx:id="clientTable" prefHeight="420" prefWidth="930" VBox.vgrow="ALWAYS"/>

</VBox>
