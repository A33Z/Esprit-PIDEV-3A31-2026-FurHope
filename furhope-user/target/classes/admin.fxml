<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.esprit.controllers.AdminController"
           stylesheets="@styles.css"
           styleClass="page">

    <Label text="🐾" mouseTransparent="true" style="-fx-font-size: 220px; -fx-opacity: 0.08;" StackPane.alignment="TOP_LEFT" translateX="-120" translateY="-40"/>
    <Label text="🐶" mouseTransparent="true" style="-fx-font-size: 180px; -fx-opacity: 0.07;" StackPane.alignment="BOTTOM_RIGHT" translateX="80" translateY="40"/>

    <VBox spacing="16" alignment="TOP_CENTER" fillWidth="true" maxWidth="1100">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="Approval Desk" styleClass="title"/>
        <Label fx:id="countLabel" text="Review pending specialists and approve directly from each card." styleClass="subtitle"/>

        <FlowPane hgap="10" vgap="10" alignment="CENTER" prefWrapLength="980">
            <TextField fx:id="searchField" promptText="Search by name, email, phone or city" prefWidth="360" minWidth="220"/>
            <ComboBox fx:id="sortCombo" prefWidth="190" minWidth="170" onAction="#applyFilters"/>
        </FlowPane>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="vetCardsContainer" hgap="14" vgap="14" alignment="TOP_CENTER" prefWrapLength="980"/>
            </content>
        </ScrollPane>

        <FlowPane hgap="12" vgap="12" alignment="CENTER">
            <Button text="Refresh" styleClass="secondary-button action-button" onAction="#refreshTable"/>
            <Button text="Back" styleClass="secondary-button action-button" onAction="#goBack"/>
        </FlowPane>
    </VBox>

</StackPane>
