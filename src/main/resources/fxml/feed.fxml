<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.esprit.furhope.controllers.feedcontroller" styleClass="feed-root">
    <ScrollPane styleClass="feed-scroll" fitToWidth="true" StackPane.alignment="TOP_CENTER">
        <VBox fx:id="postsbox" styleClass="feed-posts-box" spacing="16">
            <padding><Insets top="14" right="16" bottom="92" left="16"/></padding>
        </VBox>
    </ScrollPane>

    <Button fx:id="addPostFab" styleClass="fab-post" onAction="#onNewPostClick" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets right="20" bottom="22"/>
        </StackPane.margin>
    </Button>
</StackPane>
