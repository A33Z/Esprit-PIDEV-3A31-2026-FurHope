<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="700.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.AjouterRequest"
            styleClass="root"
            stylesheets="style.css">

    <VBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          styleClass="v-box">

        <!-- Title -->
        <Text text="Adoption Request" styleClass="title">
            <font>
                <Font size="36"/>
            </font>
        </Text>

        <!-- Animal Info Card -->
        <HBox spacing="20" alignment="CENTER" styleClass="animal-card">
            <ImageView fx:id="animalImageView" fitWidth="200" fitHeight="150" preserveRatio="true" styleClass="pet-image"/>
            <VBox spacing="10">
                <Label fx:id="animalNameLabel" text="Name: Luna" styleClass="pet-info-label"/>
                <Label fx:id="animalSpeciesLabel" text="Species: Dog" styleClass="pet-info-label"/>
                <Label fx:id="animalBreedLabel" text="Breed: Husky" styleClass="pet-info-label"/>
                <Label fx:id="animalAgeGenderLabel" text="2 Years / Male" styleClass="pet-info-label"/>
            </VBox>
        </HBox>

        <Separator/>

        <!-- Client Info Card -->
        <VBox spacing="10" styleClass="client-card">
            <Label fx:id="clientNameLabel" text="Name: Joumana" styleClass="client-info-label"/>
            <Label fx:id="clientEmailLabel" text="Email: example@mail.com" styleClass="client-info-label"/>
            <Label fx:id="clientPhoneLabel" text="Phone: 12345678" styleClass="client-info-label"/>
        </VBox>

        <!-- Message Section -->
        <VBox spacing="10" styleClass="message-section">
            <Label text="Your Message" styleClass="section-title"/>
            <TextArea fx:id="message" promptText="Write your message here..." wrapText="true" prefRowCount="5" styleClass="text-area"/>
        </VBox>

        <!-- Send Button -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="Send" fx:id="sendButton" onAction="#Envoyer"
                    prefWidth="180" prefHeight="50" styleClass="button-save"/>
        </HBox>

    </VBox>
</AnchorPane>