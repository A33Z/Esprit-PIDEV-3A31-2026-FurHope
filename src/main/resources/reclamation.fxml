<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="14" fillWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.esprit.controllers.ReclamationController"
      stylesheets="@styles.css" styleClass="page reclamation-page reclamation-themed">

    <padding>
        <Insets top="18" right="24" bottom="24" left="24"/>
    </padding>

    <HBox spacing="16" maxWidth="1100" prefWidth="1.7976931348623157E308" alignment="TOP_CENTER">
        <VBox spacing="12" styleClass="panel-card" HBox.hgrow="ALWAYS">
            <Label text="Reclamation Form" styleClass="section-title"/>
            <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT" prefWrapLength="760">
                <TextField fx:id="sujetField" promptText="Subject" prefWidth="360" minWidth="220"/>
                <ComboBox fx:id="statusCombo" prefWidth="180" minWidth="140"/>
            </FlowPane>
            <TextArea fx:id="descriptionArea" promptText="Describe the issue" prefHeight="130" maxWidth="1.7976931348623157E308" wrapText="true"/>
            <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                <Button text="Add" styleClass="primary-button action-button" onAction="#addReclamation"/>
                <Button text="Update" styleClass="secondary-button action-button" onAction="#updateReclamation"/>
                <Button text="Delete" styleClass="secondary-button action-button" onAction="#deleteReclamation"/>
                <Button text="Responses" styleClass="secondary-button action-button" onAction="#openResponses"/>
                <Button text="Refresh" styleClass="secondary-button action-button" onAction="#refreshTable"/>
                <Button text="Back" styleClass="ghost-button action-button" onAction="#goBack"/>
            </FlowPane>
        </VBox>
    </HBox>

    <VBox spacing="10" maxWidth="1100" prefWidth="1.7976931348623157E308" styleClass="panel-card" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Reclamation List" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search by subject, status, client, id" prefWidth="340" minWidth="220"/>
            <ComboBox fx:id="sortCombo" prefWidth="190" minWidth="170" onAction="#applyFilters"/>
        </HBox>
        <ListView fx:id="reclamationTable" prefHeight="420" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS"/>
    </VBox>

</VBox>
