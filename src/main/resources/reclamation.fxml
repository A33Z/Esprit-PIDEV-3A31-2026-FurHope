<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="14" fillWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.esprit.controllers.ReclamationController"
      stylesheets="@styles.css" styleClass="page">

    <padding>
        <Insets top="18" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Client Reclamation - CRUD" styleClass="title"/>

    <FlowPane hgap="10" vgap="10" alignment="CENTER" prefWrapLength="900">
        <TextField fx:id="sujetField" promptText="Sujet" prefWidth="260" minWidth="220"/>
        <ComboBox fx:id="statusCombo" prefWidth="140" minWidth="120"/>
    </FlowPane>

    <TextArea fx:id="descriptionArea" promptText="Describe the problem" prefHeight="90" maxWidth="1.7976931348623157E308" wrapText="true"/>

    <FlowPane hgap="10" vgap="10" alignment="CENTER">
        <Button text="Add" styleClass="primary-button action-button" onAction="#addReclamation"/>
        <Button text="Update" styleClass="primary-button action-button" onAction="#updateReclamation"/>
        <Button text="Delete" styleClass="secondary-button action-button" onAction="#deleteReclamation"/>
        <Button text="Responses" styleClass="secondary-button action-button" onAction="#openResponses"/>
        <Button text="Refresh" styleClass="secondary-button action-button" onAction="#refreshTable"/>
        <Button text="Back" styleClass="secondary-button action-button" onAction="#goBack"/>
    </FlowPane>

    <ListView fx:id="reclamationTable" prefHeight="390" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS"/>

</VBox>
