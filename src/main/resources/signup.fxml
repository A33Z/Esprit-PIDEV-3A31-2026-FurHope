<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.esprit.controllers.SignUpController"
           stylesheets="@styles.css"
           styleClass="page">

    <ScrollPane fitToWidth="true" styleClass="page-scroll" hbarPolicy="NEVER">
        <content>
            <VBox alignment="CENTER" spacing="18" styleClass="page-content">
                <padding>
                    <Insets top="30" right="24" bottom="40" left="24"/>
                </padding>

                <VBox spacing="14" alignment="CENTER" styleClass="card form-card">
                    <Label text="Sign Up" styleClass="title" />

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="First name" styleClass="field-label"/>
                        <TextField fx:id="firstNameField" promptText="First name" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Last name" styleClass="field-label"/>
                        <TextField fx:id="lastNameField" promptText="Last name" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Email" styleClass="field-label"/>
                        <TextField fx:id="emailField" promptText="name@example.com" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Password" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" promptText="At least 8 chars (upper/lower/number)" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Confirm password" styleClass="field-label"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Phone" styleClass="field-label"/>
                        <TextField fx:id="phoneField" promptText="+216xxxxxxxx or digits only" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Address" styleClass="field-label"/>
                        <TextField fx:id="addressField" promptText="Address" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="City" styleClass="field-label"/>
                        <TextField fx:id="cityField" promptText="City" styleClass="input"/>
                    </VBox>

                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Role" styleClass="field-label"/>
                        <ComboBox fx:id="roleCombo" styleClass="input"/>
                    </VBox>

                    <Button text="Create Account" styleClass="primary-button" onAction="#signUp" maxWidth="Infinity"/>
                    <HBox spacing="8" alignment="CENTER" styleClass="inline-link-row">
                        <Label text="Already have an account?" styleClass="field-label"/>
                        <Button text="Sign in" styleClass="inline-link-button" onAction="#goToSignIn"/>
                    </HBox>
                    <Button text="Back" styleClass="secondary-button" onAction="#goBack" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <Button fx:id="themeToggleButton"
            text="&#9728;"
            onAction="#toggleDarkMode"
            styleClass="theme-toggle-button"
            StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="16" right="16" bottom="0" left="0"/>
        </StackPane.margin>
    </Button>
</StackPane>
