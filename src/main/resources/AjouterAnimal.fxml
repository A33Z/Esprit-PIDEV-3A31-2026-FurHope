<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.AjouterAnimal">
   <children>
      <TextField fx:id="name" layoutX="53.0" layoutY="14.0" prefHeight="46.0" prefWidth="230.0" promptText="name" />
      <TextField fx:id="species" layoutX="53.0" layoutY="69.0" prefHeight="46.0" prefWidth="230.0" promptText="species" />
      <TextField fx:id="breed" layoutX="53.0" layoutY="124.0" prefHeight="46.0" prefWidth="230.0" promptText="breed" />
      <TextField fx:id="age" layoutX="53.0" layoutY="177.0" prefHeight="46.0" prefWidth="230.0" promptText="age" />
      <TextField fx:id="gender" layoutX="53.0" layoutY="231.0" prefHeight="46.0" prefWidth="230.0" promptText="gender" />
      <TextField fx:id="description" layoutX="53.0" layoutY="285.0" prefHeight="46.0" prefWidth="230.0" promptText="description" />
      <TextField fx:id="status" layoutX="53.0" layoutY="341.0" prefHeight="46.0" prefWidth="230.0" promptText="status" />
      <Button graphicTextGap="8.0" layoutX="403.0" layoutY="100.0" mnemonicParsing="false" onAction="#save" prefHeight="46.0" prefWidth="118.0" text="Save">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button layoutX="403.0" layoutY="200.0" mnemonicParsing="false" onAction="#afficher" prefHeight="46.0" prefWidth="118.0" text="Display">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
