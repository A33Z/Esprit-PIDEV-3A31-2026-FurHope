<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Label?>

<?import javafx.scene.control.ScrollPane?>
<AnchorPane prefHeight="601.0" prefWidth="918.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.AjouterAnimal"
            stylesheets="style.css"
            styleClass="root">

    <!-- Back Button -->
    <HBox layoutX="20" layoutY="20">
        <Label text="←"
               onMouseClicked="#handleRetour"
               styleClass="back-icon"/>
    </HBox>

    <ScrollPane fitToWidth="true"
                AnchorPane.topAnchor="60.0"
                AnchorPane.bottomAnchor="20.0"
                AnchorPane.leftAnchor="50.0"
                AnchorPane.rightAnchor="50.0"
                style="-fx-background-color:transparent;">

        <VBox alignment="CENTER"
              spacing="18"
              styleClass="card">

            <!-- Image Selection -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fx:id="imagePreview"
                           fitHeight="150"
                           fitWidth="200"
                           preserveRatio="true"/>
                <Button text="Choose Image"
                        onAction="#chooseimage"
                        styleClass="button"/>
            </VBox>

            <!-- Name -->
            <VBox alignment="CENTER_LEFT" spacing="5" styleClass="text-field-wrapper">
                <TextField fx:id="name" promptText="Name" styleClass="input-field"/>
            </VBox>

            <!-- Breed -->
            <VBox alignment="CENTER_LEFT" spacing="5" styleClass="text-field-wrapper">
                <TextField fx:id="breed" promptText="Breed" styleClass="input-field"/>
            </VBox>

            <!-- Species -->
            <VBox alignment="CENTER_LEFT" spacing="5" styleClass="text-field-wrapper">
                <TextField fx:id="species" promptText="Species" styleClass="input-field"/>
            </VBox>

            <!-- Age -->
            <VBox alignment="CENTER_LEFT" spacing="5" styleClass="text-field-wrapper">
                <TextField fx:id="age" promptText="Age" styleClass="input-field"/>
            </VBox>

            <!-- Gender -->
            <VBox alignment="CENTER_LEFT" spacing="5" styleClass="text-field-wrapper">
                <ComboBox fx:id="gender"
                          promptText="Gender"
                          styleClass="combo-box"/>
            </VBox>

            <!-- Description -->
            <VBox alignment="CENTER_LEFT" spacing="5" styleClass="text-field-wrapper">
                <TextField fx:id="description"
                           promptText="Description"
                           styleClass="input-field"/>
            </VBox>

            <!-- Save Button -->
            <HBox alignment="CENTER">
                <Button text="Save"
                        onAction="#save"
                        styleClass="button-save"
                        prefWidth="150"
                        prefHeight="45"/>
            </HBox>

        </VBox>

    </ScrollPane>

</AnchorPane>