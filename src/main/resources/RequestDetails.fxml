<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.requestdetails"
            prefHeight="500.0" prefWidth="600.0"
            styleClass="root"
            stylesheets="style.css">

    <VBox alignment="CENTER"
          spacing="18"
          styleClass="card"
          AnchorPane.leftAnchor="50.0"
          AnchorPane.rightAnchor="50.0"
          AnchorPane.topAnchor="50.0">

        <!-- Animal ID -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="info-container">
            <Label text="Animal ID" styleClass="info-title"/>
            <Label fx:id="animalidlabel" styleClass="readonly-label"/>
        </HBox>

        <!-- Client ID -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="info-container">
            <Label text="Client ID" styleClass="info-title"/>
            <Label fx:id="clientidlabel" styleClass="readonly-label"/>
        </HBox>

        <!-- Message -->
        <VBox spacing="8" alignment="CENTER_LEFT" styleClass="info-container">
            <Label text="Message" styleClass="info-title"/>
            <Label fx:id="messagelabel"
                   wrapText="true"
                   styleClass="readonly-label"/>
        </VBox>

        <!-- Phone -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="info-container">
            <Label text="Phone" styleClass="info-title"/>
            <Label fx:id="phonelabel" styleClass="readonly-label"/>
        </HBox>

        <!-- Address -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="info-container">
            <Label text="Address" styleClass="info-title"/>
            <Label fx:id="addresslabel" styleClass="readonly-label"/>
        </HBox>

        <!-- Status -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="info-container">
            <Label text="Status" styleClass="info-title"/>
            <Label fx:id="statusLabel" styleClass="status-badge"/>
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="20">

            <Button fx:id="modifyButton"
                    onAction="#handlemodifier"
                    text="Modify"
                    styleClass="button-save"/>

            <Button fx:id="deleteButton"
                    onAction="#handlesupprimer"
                    text="Delete"
                    styleClass="danger-button"/>

        </HBox>

    </VBox>

</AnchorPane>