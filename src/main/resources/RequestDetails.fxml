<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.requestdetails"
            prefHeight="500.0" prefWidth="600.0"
            stylesheets="style.css"
            style="-fx-background-color:#F7F7F7;">

    <VBox fx:id="rootVBox"
          alignment="CENTER"
          spacing="18"
          AnchorPane.leftAnchor="50.0"
          AnchorPane.rightAnchor="50.0"
          AnchorPane.topAnchor="50.0"
          style="-fx-background-color:white; -fx-padding:20px; -fx-background-radius:12; -fx-border-radius:12; -fx-border-color:#dddddd;">

        <!-- Animal ID -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-spacing:15; -fx-alignment:CENTER_LEFT;">
            <Label text="Animal ID" styleClass="label-bold"/>
            <Label fx:id="animalidlabel" styleClass="readonly-label"/>
        </HBox>

        <!-- Client ID -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-spacing:15; -fx-alignment:CENTER_LEFT;">
            <Label text="Client ID" styleClass="label-bold"/>
            <Label fx:id="clientidlabel" styleClass="readonly-label"/>
        </HBox>

        <!-- Message -->
        <VBox spacing="8" alignment="CENTER_LEFT" style="-fx-spacing:8; -fx-alignment:CENTER_LEFT;">
            <Label text="Message" styleClass="label-bold"/>
            <Label fx:id="messagelabel" wrapText="true" styleClass="readonly-label"/>
        </VBox>

        <!-- Phone -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-spacing:15; -fx-alignment:CENTER_LEFT;">
            <Label text="Phone" styleClass="label-bold"/>
            <Label fx:id="phonelabel" styleClass="readonly-label"/>
        </HBox>

        <!-- Address -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-spacing:15; -fx-alignment:CENTER_LEFT;">
            <Label text="Address" styleClass="label-bold"/>
            <Label fx:id="addresslabel" styleClass="readonly-label"/>
        </HBox>

        <!-- Status -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-spacing:15; -fx-alignment:CENTER_LEFT;">
            <Label text="Status" styleClass="label-bold"/>
            <Label fx:id="statusLabel" styleClass="status-badge"/>
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="modifyButton"
                    onAction="#handlemodifier"
                    text="Modify"
                    style="-fx-background-color: linear-gradient(to right, #CBB29D, #E2C5B2); -fx-text-fill: #4A3828; -fx-font-weight:bold; -fx-font-size:14px; -fx-background-radius:16;"/>

            <Button fx:id="deleteButton"
                    onAction="#handlesupprimer"
                    text="Delete"
                    style="-fx-background-color: #e74c3c; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:14px; -fx-background-radius:16;"/>
        </HBox>

    </VBox>

</AnchorPane>