<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?><?import javafx.scene.text.Font?>


<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.requestdetails"
            prefHeight="400.0" prefWidth="600.0">


    <VBox alignment="CENTER" spacing="15" style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:15; -fx-border-radius:15; -fx-border-color:#dddddd;" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">


        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="animal_id:" />
            <Label fx:id="animalidlabel" />
        </VBox>

        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="client_id:" />
            <Label fx:id="clientidlabel" />
        </VBox>

        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="message:" />
            <Label fx:id="messagelabel" />
        </VBox>

        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="phone:" />
            <Label fx:id="phonelabel" />
        </VBox>

        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="address:" />
            <Label fx:id="addresslabel" />
        </VBox>

        <!-- Status -->
        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="Status:" />
            <Label fx:id="statusLabel" />
        </VBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="modifyButton" onAction="#handlemodifier" prefHeight="38.0" prefWidth="106.0" text="Modify">
                <font>
                    <Font size="16.0" />
                </font></Button>
            <Button fx:id="deleteButton" onAction="#handlesupprimer" prefHeight="37.0" prefWidth="106.0" text="Delete">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>
        </HBox>

    </VBox>

</AnchorPane>

