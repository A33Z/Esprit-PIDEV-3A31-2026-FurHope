<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane prefHeight="700"
           prefWidth="1200"
           maxWidth="1200"
           styleClass="root"
           stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.esprit.controllers.AfficherAnimal">

    <AnchorPane>

        <!-- Header -->
        <HBox layoutY="0" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              spacing="20" style="-fx-padding: 15 20; -fx-background-color: #2c3e50; -fx-alignment: center-left;">
            <Label text="🐾 Animaux disponibles pour adoption"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="✓ Chargement..."
                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;"/>
        </HBox>

        <!-- ListView -->
        <ListView fx:id="listview"
                  layoutY="70"
                  AnchorPane.topAnchor="70.0"
                  AnchorPane.leftAnchor="20.0"
                  AnchorPane.rightAnchor="280.0"
                  AnchorPane.bottomAnchor="20.0"
                  style="-fx-control-inner-background: #ecf0f1;"/>

        <!-- Sidebar Buttons -->
        <VBox AnchorPane.rightAnchor="20.0"
              AnchorPane.topAnchor="90.0"
              AnchorPane.bottomAnchor="20.0"
              spacing="15"
              alignment="TOP_CENTER"
              style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #dddddd; -fx-border-width: 1;"
              prefWidth="240">

            <Label text="🎯 Menu"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Separator/>

            <Button fx:id="btnAddAnimal"
                    text="➕ Ajouter animal"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 12 20; -fx-background-radius: 8;"
                    prefWidth="Infinity" prefHeight="45"/>

            <Button fx:id="btnFavorite"
                    text="❤️ Mes favoris"
                    onAction="#openFavoriteList"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 12 20; -fx-background-radius: 8;"
                    prefWidth="Infinity" prefHeight="45"/>

            <Button fx:id="btnMyRequests"
                    text="📋 Mes demandes"
                    onAction="#openMessageRequests"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 12 20; -fx-background-radius: 8;"
                    prefWidth="Infinity" prefHeight="45"/>

            <Button fx:id="btnRequests"
                    text="📧 Demandes reçues"
                    onAction="#openRequests"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 12 20; -fx-background-radius: 8;"
                    prefWidth="Infinity" prefHeight="45"/>

            <Button fx:id="btnMyAnimals"
                    text="🏠 Mes animaux"
                    onAction="#openMyAnimals"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 12 20; -fx-background-radius: 8;"
                    prefWidth="Infinity" prefHeight="45"/>

            <Button text="🚪 Logout" onAction="#logout" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 12 20; -fx-background-radius: 8;"
                    prefWidth="Infinity" prefHeight="45" />


        </VBox>

    </AnchorPane>

</StackPane>