                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: #fff7ed; -fx-background-radius: 8;
                             -fx-border-color: #fed7aa; -fx-border-radius: 8; -fx-padding: 8 12;">
                    <Spinner fx:id="endHourSpinner" min="0" max="23" initialValue="10"
                             editable="true" prefWidth="70"/>
                    <Label text="h" style="-fx-font-weight: bold; -fx-text-fill: #f97316; -fx-font-size: 15;"/>
                    <Spinner fx:id="endMinSpinner" min="0" max="59" initialValue="0"
                             editable="true" prefWidth="70"/>
                    <Label text="min" style="-fx-font-weight: bold; -fx-text-fill: #f97316;"/>
