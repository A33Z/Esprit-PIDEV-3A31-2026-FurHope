<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.DisponibiliteFormController"
      spacing="0"
      style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5);">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #f97316; -fx-padding: 18 28;">
        <Label fx:id="titleLabel" text="ðŸ“… Ajouter une DisponibilitÃ©"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Back" onAction="#onBackAccueil"
