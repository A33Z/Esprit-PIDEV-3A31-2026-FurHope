                <Button text="ðŸ  Dashboard" onAction="#onGoHome"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #78716c; -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-font-weight: bold;
                               -fx-font-size: 13; -fx-padding: 11 0; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </VBox>
</VBox>