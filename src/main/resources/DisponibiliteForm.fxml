    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" style="-fx-padding: 30;">
        <VBox spacing="16" maxWidth="460"
              style="-fx-background-color: white; -fx-background-radius: 16;
                     -fx-padding: 28;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.10),12,0,0,4);">

            <!-- Date -->
            <VBox spacing="6">
