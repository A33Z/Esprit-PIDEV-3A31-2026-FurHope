                                 -fx-font-size: 13; -fx-padding: 4 8; -fx-cursor: hand;"/>
            </VBox>

            <!-- Boutons -->
            <HBox spacing="10" style="-fx-padding-top: 6;">
                <Button fx:id="saveButton" text="âœ… Ajouter" onAction="#onSave"
