                <DatePicker fx:id="dateField" maxWidth="Infinity"
                            style="-fx-border-color: #fed7aa; -fx-border-radius: 8; -fx-font-size: 13;"/>
            </VBox>

            <!-- Heure dÃ©but -->
            <VBox spacing="6">
