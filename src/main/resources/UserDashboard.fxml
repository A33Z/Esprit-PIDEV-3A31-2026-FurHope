<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.UserDashboardController"
            styleClass="user-page"
            stylesheets="@AppTheme.css"
            prefHeight="860.0" prefWidth="1320.0">

    <children>
        <VBox styleClass="page-content" spacing="14.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <VBox spacing="2.0">
                        <children>
                            <Label text="User Dashboard" styleClass="header-title" />
                            <Label text="Explore hotels from live APIs, then book directly." styleClass="header-subtitle" />
                        </children>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="sessionLabel" styleClass="session-chip user-chip" />
                </children>
            </HBox>

            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <children>
                    <Label text="City" styleClass="field-label" />
                    <TextField fx:id="cityField" promptText="Search city (example: New York)" prefWidth="220.0" />
                    <ComboBox fx:id="sortComboBox" prefWidth="150.0" promptText="Sort" />
                    <ComboBox fx:id="ratingFilterComboBox" prefWidth="140.0" promptText="Rating Filter" />
                    <Button text="Explore Hotels" styleClass="button primary-button" onAction="#handleExploreHotels" />
                    <Button text="Open Map" styleClass="button secondary-button" onAction="#handleOpenMapView" />
                    <Button text="Refresh Reservations" styleClass="button secondary-button" onAction="#handleRefreshReservations" />
                    <Button text="AI Support" styleClass="button secondary-button" onAction="#handleOpenSupportCenter" />
                    <Button text="Back" styleClass="button ghost-button" onAction="#gotoacceuil" />
                    <Button text="Logout" styleClass="button ghost-button" onAction="#gotowelcome" />
                </children>
            </HBox>

            <Label fx:id="dashboardMessageLabel" text="" styleClass="header-subtitle" />

            <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                <children>
                    <VBox styleClass="card" spacing="10.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="Hotel Exploration" styleClass="section-title" />
                            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="hotel-scroll-pane">
                                <content>
                                    <TilePane fx:id="hotelCardContainer"
                                              hgap="12.0"
                                              vgap="12.0"
                                              prefColumns="2"
                                              prefTileWidth="520.0"
                                              styleClass="hotel-card-list" />
                                </content>
                            </ScrollPane>
                        </children>
                    </VBox>

                    <VBox styleClass="card reservation-side-panel" spacing="8.0">
                        <children>
                            <Label text="My Reservations" styleClass="section-title" />
                            <Label text="Modify pending bookings, cancel eligible reservations, and track approval status in real time."
                                   styleClass="header-subtitle"
                                   wrapText="true" />
                            <ListView fx:id="myReservationListView" VBox.vgrow="ALWAYS" />
                        </children>
                    </VBox>
                </children>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
