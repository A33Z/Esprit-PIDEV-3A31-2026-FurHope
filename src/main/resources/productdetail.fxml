<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projet.controller.produitdetail"
            stylesheets="@style.css"
            prefHeight="650"
            prefWidth="1000"
            styleClass="detail-root">

    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-padding: 15;"
              styleClass="topbar">

            <Button text="Back to Shop"
                    onAction="#backToShop"
                    styleClass="secondary-button"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Product Detail"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

        </HBox>
    </top>

    <center>
        <StackPane>

            <HBox spacing="50"
                  alignment="CENTER"
                  styleClass="detail-container">

                <ImageView fx:id="productImage"
                           fitHeight="350"
                           fitWidth="350"
                           preserveRatio="true"
                           styleClass="detail-image"/>

                <VBox spacing="20"
                      alignment="CENTER_LEFT"
                      styleClass="detail-info">

                    <Label fx:id="productName"
                           styleClass="detail-name"/>

                    <Label fx:id="productPrice"
                           styleClass="detail-price"/>

                    <TextArea fx:id="productDescription"
                              wrapText="true"
                              editable="false"
                              prefWidth="400"
                              prefHeight="180"
                              styleClass="detail-description"/>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="Quantity:"
                               styleClass="detail-label"/>
                        <Spinner fx:id="quantitySpinner"
                                 prefWidth="90"
                                 styleClass="detail-spinner"/>
                    </HBox>

                    <Button text="Add to Cart"
                            fx:id="addToCartBtn"
                            onAction="#addToCart"
                            prefWidth="220"
                            styleClass="detail-button"/>

                </VBox>

            </HBox>

        </StackPane>
    </center>

</BorderPane>
