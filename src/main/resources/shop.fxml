<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<AnchorPane stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="contentPane"
            fx:controller="com.projet.controller.produits">

    <children>

        <!-- Header bar -->
        <HBox fx:id="topbar"
              spacing="10"
              alignment="CENTER_LEFT"
              styleClass="topbar"
              AnchorPane.topAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              prefHeight="60">

            <Button text="Menu"
                    onAction="#toggleDrawer"
                    styleClass="menu-button"/>

            <Button text="Retour"
                    onAction="#goBack"
                    styleClass="secondary-button"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Shop"
                   styleClass="title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Cart"
                    fx:id="cartBtn"
                    onAction="#openCart"
                    styleClass="secondary-button"/>

        </HBox>

        <!-- Main content -->
        <AnchorPane AnchorPane.topAnchor="60"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <HBox spacing="10"
                  alignment="CENTER"
                  AnchorPane.topAnchor="20"
                  AnchorPane.leftAnchor="0"
                  AnchorPane.rightAnchor="0">

                <TextField fx:id="searchField"
                           promptText="Rechercher produit..."
                           prefWidth="260"/>


            </HBox>

            <ScrollPane fitToWidth="true"
                        AnchorPane.topAnchor="80"
                        AnchorPane.bottomAnchor="40"
                        AnchorPane.leftAnchor="40"
                        AnchorPane.rightAnchor="40">

                <FlowPane fx:id="productGrid"
                          hgap="20"
                          vgap="20"
                          alignment="CENTER">

                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                </FlowPane>

            </ScrollPane>

            <VBox fx:id="drawer"
                  prefWidth="200"
                  spacing="15"
                  styleClass="drawer"
                  alignment="TOP_CENTER"
                  AnchorPane.topAnchor="0"
                  AnchorPane.bottomAnchor="0"
                  AnchorPane.leftAnchor="0">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Admin" styleClass="drawer-title"/>

                <Button text="Gestion Produits"
                        onAction="#controlproduit"
                        styleClass="drawer-button"/>

                <Button text="Order History"
                        onAction="#openOrderHistory"
                        styleClass="drawer-button"/>
            </VBox>

        </AnchorPane>



    </children>

</AnchorPane>
