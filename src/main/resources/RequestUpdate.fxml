<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.requestupdate"
            prefHeight="400.0" prefWidth="600.0">
    <VBox alignment="CENTER" spacing="10"
          style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:15; -fx-border-radius:15; -fx-border-color:#dddddd;"
          AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0" AnchorPane.bottomAnchor="50.0">


        <!-- Name -->
        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text=" animal_id:"/>
            <TextField fx:id=" animalidfield"/>
        </VBox>

        <!-- Species -->
        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="client_id:"/>
            <TextField fx:id="clientidfield"/>
        </VBox>

        <!-- Description -->
        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="message:"/>
            <TextArea fx:id="messagefield" wrapText="true" prefHeight="60"/>
        </VBox>

        <!-- Age -->
        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="phone:"/>
            <TextField fx:id="phonefield"/>
        </VBox>

        <!-- Gender -->
        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="address:"/>
            <TextField fx:id="addressfield"/>
        </VBox>

        <!-- Status -->
        <VBox alignment="CENTER_LEFT" style="-fx-background-color:#f5f5f5; -fx-padding:10; -fx-background-radius:10;">
            <Label style="-fx-font-weight:bold;" text="Status:"/>
            <TextField fx:id="statusField"/>
        </VBox>


        <!-- Save Button -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="saveButton" onAction="#handleSave" text="Save" prefHeight="38" prefWidth="106"
                    style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-background-radius:10;">
                <font>
                    <Font size="16"/>
                </font>
            </Button>
        </HBox>

    </VBox>
</AnchorPane>
