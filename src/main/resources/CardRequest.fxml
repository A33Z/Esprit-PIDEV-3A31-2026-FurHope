<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.CardRequest"
            prefHeight="150.0" prefWidth="350.0">

    <VBox fx:id="cardRoot"
          spacing="10"
          alignment="TOP_LEFT"
          style="-fx-background-color:white;
                 -fx-background-radius:12;
                 -fx-border-radius:12;
                 -fx-border-color:#dddddd;
                 -fx-padding:15;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 5, 0, 0, 2);">

        <!-- Animal Info -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ImageView fx:id="animalImageView"
                       fitWidth="50" fitHeight="50"
                       style="-fx-background-radius:8;"
                       preserveRatio="true"/>
            <Label fx:id="animalLabel"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>
        </HBox>

        <!-- Requester Info -->
        <Label fx:id="clientLabel"
               style="-fx-font-size:14px; -fx-text-fill:#555555;"/>

        <!-- Optional Status -->
        <Label fx:id="statusLabel"
               style="-fx-text-fill:#2ecc71; -fx-font-weight:bold;"/>

    </VBox>
</AnchorPane>