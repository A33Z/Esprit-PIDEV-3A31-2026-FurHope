<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.HomeController"
      alignment="CENTER" spacing="18"
      style="-fx-background-color: linear-gradient(to bottom right, #fef3c7, #bfdbfe, #fecdd3); -fx-padding: 40;">

    <Label text="Clinique Veterinaire"
           style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

    <HBox spacing="16" alignment="CENTER">
        <Button text="Disponibilite Formulaire" onAction="#goDisponibiliteForm"
                style="-fx-font-size: 14; -fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 20;"/>
        <Button text="Disponibilite Affichage" onAction="#goDisponibiliteList"
                style="-fx-font-size: 14; -fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 20;"/>
    </HBox>

    <HBox spacing="16" alignment="CENTER">
        <Button text="Rendez-vous Formulaire" onAction="#goRendezvousForm"
                style="-fx-font-size: 14; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 20;"/>
        <Button text="Rendez-vous Affichage" onAction="#goRendezvousList"
                style="-fx-font-size: 14; -fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 20;"/>
    </HBox>

    <!-- ✅ NOUVEAU : Bouton Chatbot IA -->
    <HBox spacing="16" alignment="CENTER">
        <Button text="🩺 Assistant IA Médical" onAction="#openChatbot"
                style="-fx-font-size: 14; -fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-background-radius: 12; -fx-padding: 12 20;
                       -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

</VBox>