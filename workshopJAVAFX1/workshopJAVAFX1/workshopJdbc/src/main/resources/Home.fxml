<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.HomeController"
      alignment="CENTER" spacing="24"
      style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5, #fef3c7);
             -fx-padding: 50;">

    <!-- Titre -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="🐾 Clinique Vétérinaire"
               style="-fx-font-size: 38; -fx-font-weight: bold; -fx-text-fill: #92400e;"/>
        <Label text="Bienvenue sur votre espace de santé animale"
               style="-fx-font-size: 14; -fx-text-fill: #b45309;"/>
    </VBox>

    <HBox style="-fx-background-color: #fed7aa; -fx-min-height: 2;" maxWidth="400"/>

    <!-- Espace Vétérinaire -->
    <VBox alignment="CENTER" spacing="8">
        <Label text="👨‍⚕️ Vétérinaires"
               style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-font-style: italic;"/>
        <Button text="🔐 Espace Vétérinaire" onAction="#goLogin"
                style="-fx-font-size: 15; -fx-background-color: #f97316;
                       -fx-text-fill: white; -fx-background-radius: 12;
                       -fx-padding: 14 40; -fx-font-weight: bold; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian,rgba(249,115,22,0.4),8,0,0,3);"/>
    </VBox>

    <!-- Espace Client -->
    <VBox alignment="CENTER" spacing="8">
        <Label text="👤 Clients"
               style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-font-style: italic;"/>
        <Button text="👤 Espace Client" onAction="#goLoginClient"
                style="-fx-font-size: 15; -fx-background-color: #eab308;
                       -fx-text-fill: white; -fx-background-radius: 12;
                       -fx-padding: 14 40; -fx-font-weight: bold; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian,rgba(234,179,8,0.4),8,0,0,3);"/>
    </VBox>

</VBox>