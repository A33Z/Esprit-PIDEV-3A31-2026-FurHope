<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DisponibiliteFormController"
      spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #fef9c3, #bbf7d0); -fx-padding: 28;">

    <Label fx:id="titleLabel" text="Ajouter disponibilite" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #14532d;"/>
    <Label text="vet_id"/>
    <TextField fx:id="vetIdField" promptText="entier > 0"/>

    <Label text="statut"/>
    <ComboBox fx:id="statutBox" promptText="VALABLE / NONVALABLE"/>

    <Label text="starttime (HH:mm)"/>
    <TextField fx:id="startTimeField" promptText="08:30"/>

    <Label text="endtime (HH:mm)"/>
    <TextField fx:id="endTimeField" promptText="10:00"/>

    <HBox spacing="12">
        <Button fx:id="saveButton" text="Ajouter" onAction="#onSave"
                style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 10;"/>
        <Button text="Voir affichage" onAction="#onGoList"
                style="-fx-background-color: #15803d; -fx-text-fill: white; -fx-background-radius: 10;"/>
        <Button text="Accueil" onAction="#onGoHome"
                style="-fx-background-color: #374151; -fx-text-fill: white; -fx-background-radius: 10;"/>
    </HBox>
</VBox>
