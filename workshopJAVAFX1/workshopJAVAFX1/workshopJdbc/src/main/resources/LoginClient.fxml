<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.LoginClientController"
      alignment="CENTER" spacing="16"
      style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5, #fef3c7);
             -fx-padding: 50;">

    <Label text=" FurHope "
           style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #92400e;"/>
    <Label text="Espace Client"
           style="-fx-font-size: 15; -fx-text-fill: #b45309;"/>

    <VBox spacing="12" alignment="CENTER"
          style="-fx-background-color: white; -fx-padding: 30;
                 -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.1),10,0,0,4);
                 -fx-min-width: 350;">

        <TextField fx:id="emailField" promptText="📧 Email"
                   style="-fx-font-size: 13; -fx-padding: 10;
                          -fx-background-radius: 8; -fx-border-color: #fed7aa;
                          -fx-border-radius: 8;"/>

        <PasswordField fx:id="passwordField" promptText="🔒 Mot de passe"
                       style="-fx-font-size: 13; -fx-padding: 10;
                              -fx-background-radius: 8; -fx-border-color: #fed7aa;
                              -fx-border-radius: 8;"/>

        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>

        <Button text="Se connecter" onAction="#login"
                style="-fx-font-size: 14; -fx-background-color: #eab308;
                       -fx-text-fill: white; -fx-background-radius: 8;
                       -fx-padding: 10 30; -fx-font-weight: bold;
                       -fx-cursor: hand;" maxWidth="Infinity"/>

        <Button text="← Retour" onAction="#goBack"
                style="-fx-font-size: 12; -fx-background-color: transparent;
                       -fx-text-fill: #9ca3af; -fx-cursor: hand;"/>
    </VBox>
</VBox>