<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.MesAvisController"
      spacing="0"
      style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5);">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #eab308; -fx-padding: 18 28;">
        <Label text="⭐ Mes Avis"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="← Retour" onAction="#goBack"
                style="-fx-background-color: white; -fx-text-fill: #eab308;
                       -fx-font-weight: bold; -fx-background-radius: 8;
                       -fx-cursor: hand; -fx-padding: 6 14;"/>
    </HBox>

    <Label text="Consultations terminées en attente d'avis"
           style="-fx-font-size: 13; -fx-text-fill: #b45309; -fx-padding: 12 28;"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-background-color: transparent;
                       -fx-border-color: transparent;">
        <VBox fx:id="avisContainer" spacing="12"
              style="-fx-padding: 0 24 24 24;"/>
    </ScrollPane>
</VBox>