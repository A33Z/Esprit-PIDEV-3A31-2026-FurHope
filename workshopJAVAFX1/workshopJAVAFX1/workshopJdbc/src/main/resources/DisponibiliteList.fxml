<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.DisponibiliteListController"
      spacing="20"
      alignment="TOP_CENTER"
      style="-fx-background-color: linear-gradient(to bottom right, #e8f5e9, #bbf7d0);
             -fx-padding: 30;">

    <!-- Titre principal -->
    <Label text="Gestion des Disponibilités"
           style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #14532d;"/>

    <!-- Sous-titre -->
    <Label text="Cliquez sur un élément pour voir les détails, modifier ou supprimer."
           style="-fx-font-size: 15; -fx-text-fill: #166534;"/>

    <!-- Liste stylisée -->
    <ListView fx:id="disponibiliteList"
              prefHeight="480"
              prefWidth="820"
              style="-fx-background-color: #f0fdf4;
                     -fx-border-color: #86efac;
                     -fx-border-radius: 10;
                     -fx-background-radius: 10;
                     -fx-font-size: 16;
                     -fx-font-family: 'Segoe UI';
                     -fx-text-fill: #064e3b;">
        <effect>
            <DropShadow radius="8" color="#a7f3d0"/>
        </effect>
    </ListView>

    <!-- Zone de détails -->
    <Label fx:id="detailsLabel"
           text="Sélectionnez une disponibilité pour voir les détails."
           wrapText="true"
           style="-fx-font-size: 14; -fx-text-fill: #065f46;"/>

    <HBox spacing="12" alignment="CENTER">
        <Button text="➕ Ajouter" onAction="#onAdd"
                style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
        <Button text="✏️ Modifier" onAction="#onEdit"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
        <Button text="🗑 Supprimer" onAction="#onDelete"
                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
        <Button text="🔄 Actualiser" onAction="#onRefresh"
                style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
        <Button text="🏠 Accueil" onAction="#onBackHome"
                style="-fx-background-color: #374151; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
    </HBox>
</VBox>