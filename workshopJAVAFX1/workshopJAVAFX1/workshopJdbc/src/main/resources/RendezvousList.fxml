<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.RendezvousListController"
      spacing="20"
      alignment="TOP_CENTER"
      style="-fx-background-color: linear-gradient(to bottom right, #dbeafe, #bfdbfe, #fef3c7); -fx-padding: 30;">

    <Label text="Gestion des Rendez-vous"
           style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>

    <TableView fx:id="rendezvousTable" prefWidth="820" prefHeight="480">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colClient" text="Client ID" prefWidth="100"/>
            <TableColumn fx:id="colVet" text="Vétérinaire ID" prefWidth="100"/>
            <TableColumn fx:id="colAnimal" text="Animal ID" prefWidth="100"/>
            <TableColumn fx:id="colDisponibilite" text="Disponibilité ID" prefWidth="120"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="220"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER">
        <Button text="➕ Ajouter" onAction="#onAdd"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
        <Button text="✏️ Modifier" onAction="#onEdit"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
        <Button text="🗑 Supprimer" onAction="#onDelete"
                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
        <Button text="🔄 Actualiser" onAction="#onRefresh"
                style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
        <Button text="🏠 Accueil" onAction="#onBackHome"
                style="-fx-background-color: #374151; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8;"/>
    </HBox>
</VBox>