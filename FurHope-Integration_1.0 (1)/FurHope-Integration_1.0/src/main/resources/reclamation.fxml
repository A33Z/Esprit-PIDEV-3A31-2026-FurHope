<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="16" fillWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ReclamationController"
      stylesheets="@ticket-management.css" styleClass="ticket-page">

    <padding>
        <Insets top="24" right="26" bottom="26" left="26"/>
    </padding>

    <VBox spacing="4" alignment="CENTER">
        <Label text="Client Reclamation" styleClass="ticket-title"/>
        <Label text="Track and manage support tickets with clear status and timeline." styleClass="ticket-subtitle"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER" maxWidth="1100">
        <TextField fx:id="searchField" promptText="Search subject, description, client id..." prefWidth="460" styleClass="tm-input"/>
        <ComboBox fx:id="filterStatusCombo" prefWidth="180" styleClass="tm-input"/>
        <ComboBox fx:id="sortCombo" prefWidth="220" onAction="#applyFilters" styleClass="tm-input"/>
    </HBox>

    <VBox spacing="12" styleClass="tm-card tm-form-card" maxWidth="1100">
        <Label text="Ticket Editor" styleClass="tm-section-title"/>
        <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT" prefWrapLength="1000">
            <TextField fx:id="sujetField" promptText="Subject" prefWidth="420" styleClass="tm-input"/>
            <ComboBox fx:id="statusCombo" prefWidth="180" styleClass="tm-input"/>
        </FlowPane>
        <TextArea fx:id="descriptionArea" promptText="Describe the problem" prefHeight="100" wrapText="true" styleClass="tm-textarea"/>
        <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
            <Button text="Add" styleClass="btn-primary-green action-button" onAction="#addReclamation"/>
            <Button text="Update" styleClass="btn-outline action-button" onAction="#updateReclamation"/>
            <Button text="Delete" styleClass="btn-danger action-button" onAction="#deleteReclamation"/>
            <Button text="Responses" styleClass="btn-outline action-button" onAction="#openResponses"/>
            <Region prefWidth="8"/>
            <Button text="Refresh" styleClass="btn-neutral action-button" onAction="#refreshTable"/>
            <Button text="Back" styleClass="btn-neutral action-button" onAction="#goBack"/>
        </FlowPane>
    </VBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="tm-scroll" VBox.vgrow="ALWAYS">
        <content>
            <ListView fx:id="reclamationTable" maxWidth="1.7976931348623157E308" styleClass="tm-list"/>
        </content>
    </ScrollPane>

</VBox>
