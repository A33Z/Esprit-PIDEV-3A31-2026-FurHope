<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="16" fillWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.esprit.controllers.ReponseController"
      stylesheets="@ticket-management.css" styleClass="ticket-page">

    <padding>
        <Insets top="24" right="26" bottom="26" left="26"/>
    </padding>

    <VBox spacing="4" alignment="CENTER">
        <Label text="Response Management" styleClass="ticket-title"/>
        <Label text="Handle ticket conversations in a clean admin workflow." styleClass="ticket-subtitle"/>
    </VBox>

    <VBox spacing="10" styleClass="tm-card tm-summary-card" maxWidth="1100">
        <Label text="Ticket Summary" styleClass="tm-section-title"/>
        <HBox spacing="12">
            <Label fx:id="ticketIdLabel" text="Reclamation #: -" styleClass="summary-pill"/>
            <Label fx:id="ticketStatusLabel" text="Status: -" styleClass="summary-pill"/>
            <Label fx:id="ticketClientLabel" text="Client: -" styleClass="summary-pill"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="reclamationIdField" promptText="Reclamation ID" prefWidth="220" styleClass="tm-input"/>
            <Button text="Refresh" styleClass="btn-neutral action-button" onAction="#refreshTable"/>
            <Button text="Back" styleClass="btn-neutral action-button" onAction="#goBack"/>
        </HBox>
    </VBox>

    <VBox spacing="12" styleClass="tm-card tm-form-card" maxWidth="1100">
        <Label text="Admin Reply" styleClass="tm-section-title"/>
        <TextArea fx:id="messageArea" promptText="Write admin response" prefHeight="90" wrapText="true" styleClass="tm-textarea"/>
        <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
            <Button fx:id="generateAiButton" text="Generate AI Response" styleClass="btn-outline action-button" onAction="#generateAiResponse"/>
            <Button fx:id="addButton" text="Add" styleClass="btn-primary-green action-button" onAction="#addReponse"/>
            <Button fx:id="updateButton" text="Update" styleClass="btn-outline action-button" onAction="#updateReponse"/>
            <Button fx:id="deleteButton" text="Delete" styleClass="btn-danger action-button" onAction="#deleteReponse"/>
        </FlowPane>
    </VBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="tm-scroll" VBox.vgrow="ALWAYS">
        <content>
            <ListView fx:id="reponseTable" maxWidth="1.7976931348623157E308" styleClass="tm-list conversation-list"/>
        </content>
    </ScrollPane>

</VBox>
