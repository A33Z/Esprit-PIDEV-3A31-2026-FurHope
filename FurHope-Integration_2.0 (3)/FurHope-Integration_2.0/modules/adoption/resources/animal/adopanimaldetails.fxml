<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.animal.controllers.adopdetails"
            styleClass="root"
            stylesheets="@style.css">

    <top>
        <HBox styleClass="top-bar">
            <Button text="%nav.back" onAction="#goBack" styleClass="button-secondary"/>
            <Button text="%nav.home" onAction="#goHome" styleClass="button-secondary"/>
            <Label text="%page.animalDetails.title" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%lang.fr" onAction="#setFrench" styleClass="lang-button"/>
            <Button text="%lang.en" onAction="#setEnglish" styleClass="lang-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <StackPane fx:id="centerContainer" alignment="CENTER">
                <VBox alignment="TOP_CENTER"
                      spacing="14"
                      maxWidth="760"
                      prefWidth="760"
                      style="-fx-padding: 16;">

                    <VBox spacing="12" styleClass="card">
                        <ImageView fx:id="petImage"
                                   fitWidth="360"
                                   fitHeight="240"
                                   preserveRatio="true"
                                   styleClass="section-container"/>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="petName" text="%animal.card.nameDefault" styleClass="pet-name"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="petStatus" text="%animal.card.statusDefault" styleClass="status-badge"/>
                        </HBox>

                        <HBox spacing="12" alignment="CENTER" styleClass="section-container">
                            <VBox alignment="CENTER" spacing="4" styleClass="mini-box">
                                <Label text="%field.gender" styleClass="mini-title"/>
                                <Label fx:id="petGender" text="-" styleClass="mini-value"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="4" styleClass="mini-box">
                                <Label text="%age" styleClass="mini-title"/>
                                <Label fx:id="petAge" text="-" styleClass="mini-value"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="4" styleClass="mini-box">
                                <Label text="%field.species" styleClass="mini-title"/>
                                <Label fx:id="petSpecies" text="-" styleClass="mini-value"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="4" styleClass="mini-box">
                                <Label text="%field.breed" styleClass="mini-title"/>
                                <Label fx:id="petBreed" text="-" styleClass="mini-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="10" styleClass="card">
                        <Label text="%field.description" styleClass="label-bold"/>
                        <Label fx:id="petDescription" wrapText="true" text="-" styleClass="section-value"/>
                    </VBox>

                    <VBox spacing="10" styleClass="card">
                        <Label text="%care.title" styleClass="label-bold"/>

                        <VBox spacing="4">
                            <Label text="%care.exercise" styleClass="info-title"/>
                            <Label fx:id="careExerciseLabel" wrapText="true" styleClass="section-value"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="%care.diet" styleClass="info-title"/>
                            <Label fx:id="careDietLabel" wrapText="true" styleClass="section-value"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="%care.environment" styleClass="info-title"/>
                            <Label fx:id="careEnvironmentLabel" wrapText="true" styleClass="section-value"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="%care.grooming" styleClass="info-title"/>
                            <Label fx:id="careGroomingLabel" wrapText="true" styleClass="section-value"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="%care.training" styleClass="info-title"/>
                            <Label fx:id="careTrainingLabel" wrapText="true" styleClass="section-value"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="8" styleClass="card">
                        <Label text="%owner.info" styleClass="label-bold"/>
                        <HBox spacing="8" styleClass="info-container">
                            <Label text="%owner.name" styleClass="info-title"/>
                            <Label fx:id="ownerNameLabel" styleClass="info-value"/>
                        </HBox>
                        <HBox spacing="8" styleClass="info-container">
                            <Label text="%owner.email" styleClass="info-title"/>
                            <Label fx:id="ownerEmailLabel" styleClass="info-value"/>
                        </HBox>
                        <HBox spacing="8" styleClass="info-container">
                            <Label text="%owner.phone" styleClass="info-title"/>
                            <Label fx:id="ownerPhoneLabel" styleClass="info-value"/>
                        </HBox>
                        <HBox spacing="8" styleClass="info-container">
                            <Label text="%owner.role" styleClass="info-title"/>
                            <Label fx:id="ownerRoleLabel" styleClass="info-value"/>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 16 16 16;">
            <Button fx:id="adoptButton"
                    text="%action.adoptNow"
                    onAction="#handleAdopt"
                    prefWidth="170"
                    styleClass="button-save"/>
            <Button text="%nav.back" onAction="#goBack" styleClass="button-secondary" prefWidth="120"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%lang.fr" onAction="#setFrench" styleClass="lang-button"/>
            <Button text="%lang.en" onAction="#setEnglish" styleClass="lang-button"/>
        </HBox>
    </bottom>
</BorderPane>

