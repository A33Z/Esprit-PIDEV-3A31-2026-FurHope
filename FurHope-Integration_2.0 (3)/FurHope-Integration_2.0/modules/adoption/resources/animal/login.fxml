<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.animal.controllers.login"
            styleClass="root"
            stylesheets="@style.css">

    <top>
        <HBox styleClass="top-bar">
            <Button text="%nav.back" onAction="#goBack" styleClass="button-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%lang.fr" onAction="#setFrench" styleClass="lang-button"/>
            <Button text="%lang.en" onAction="#setEnglish" styleClass="lang-button"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="14" style="-fx-padding: 28;">
            <VBox alignment="CENTER" spacing="6" styleClass="card" maxWidth="480">
                <Label text="%login.heading" styleClass="pet-name"/>
                <Label text="%login.subtitle" styleClass="page-subtitle"/>

                <TextField fx:id="emailField"
                           promptText="%login.prompt.email"
                           styleClass="input-field"
                           maxWidth="360"/>

                <PasswordField fx:id="passwordField"
                               promptText="%login.prompt.password"
                               styleClass="input-field"
                               maxWidth="360"/>

                <Label fx:id="errorLabel" style="-fx-font-size: 12;"/>

                <HBox alignment="CENTER" spacing="10">
                    <Button text="%login.signIn" onAction="#login" styleClass="button-save"/>
                    <Button text="%nav.back" onAction="#goBack" styleClass="button-secondary"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>


