<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.animal.controllers.requestupdate"
            prefHeight="760.0"
            prefWidth="920.0"
            styleClass="root adoption-page"
            stylesheets="@style.css">

    <top>
        <HBox styleClass="top-bar adoption-top-bar">
            <Button text="%nav.back" onAction="#goBack" styleClass="button-secondary"/>
            <Button text="%nav.home" onAction="#goHome" styleClass="button-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%lang.fr" onAction="#setFrench" styleClass="lang-button"/>
            <Button text="%lang.en" onAction="#setEnglish" styleClass="lang-button"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="card adoption-detail-card"
              maxWidth="760">

            <VBox spacing="5" styleClass="text-field-wrapper">
                <Label text="%request.field.animalId" styleClass="label-bold"/>
                <TextField fx:id="animalidfield" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5" styleClass="text-field-wrapper">
                <Label text="%request.field.clientCompteId" styleClass="label-bold"/>
                <TextField fx:id="clientidfield" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5" styleClass="text-field-wrapper">
                <Label text="%addRequest.message" styleClass="label-bold"/>
                <TextArea fx:id="messagefield" wrapText="true" prefHeight="90" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5" styleClass="text-field-wrapper">
                <Label text="%request.card.phone" styleClass="label-bold"/>
                <TextField fx:id="phonefield" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5" styleClass="text-field-wrapper">
                <Label text="%request.card.address" styleClass="label-bold"/>
                <TextField fx:id="addressfield" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5" styleClass="text-field-wrapper">
                <Label text="%field.status" styleClass="label-bold"/>
                <TextField fx:id="statusField" styleClass="input-field"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="adoption-footer-bar">
            <Button fx:id="saveButton"
                    onAction="#handleSave"
                    text="%save"
                    styleClass="button-save"
                    prefWidth="140"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%lang.fr" onAction="#setFrench" styleClass="lang-button"/>
            <Button text="%lang.en" onAction="#setEnglish" styleClass="lang-button"/>
        </HBox>
    </bottom>

</BorderPane>

