<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.animal.controllers.Home"
            stylesheets="@style.css"
            styleClass="root">

    <top>
        <HBox styleClass="top-bar">
            <Label text="%home.title" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnFr" text="%lang.fr" onAction="#setFrench" styleClass="lang-button"/>
            <Button fx:id="btnEn" text="%lang.en" onAction="#setEnglish" styleClass="lang-button"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="22">
            <VBox alignment="CENTER" spacing="6" styleClass="card">
                <Label text="%home.title" styleClass="pet-name"/>
                <Label text="%home.subtitle" styleClass="page-subtitle"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Label text="%home.clientSpace" styleClass="section-value"/>
                <Button text="%home.login"
                        onAction="#goLoginClient"
                        styleClass="button-save"
                        prefWidth="220"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>

