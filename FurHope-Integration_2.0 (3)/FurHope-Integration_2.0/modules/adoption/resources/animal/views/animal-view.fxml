<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.animal.controllers.ExampleI18nController"
      spacing="16"
      style="-fx-padding: 24;" stylesheets="@../../css/app.css">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="%lang.fr" onAction="#switchToFrench"/>
        <Button text="%lang.en" onAction="#switchToEnglish"/>
    </HBox>

    <Label text="%title"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%name"/>
            <TextField promptText="%name"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%type"/>
            <TextField promptText="%type"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%age"/>
            <TextField promptText="%age"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <Button text="%addAnimal" onAction="#addAnimal"/>
        <Button text="%delete" onAction="#deleteAnimal"/>
        <Button text="%update" onAction="#updateAnimal"/>
        <Button text="%save" onAction="#save"/>
        <Button text="%cancel" onAction="#cancel"/>
    </HBox>

</VBox>




