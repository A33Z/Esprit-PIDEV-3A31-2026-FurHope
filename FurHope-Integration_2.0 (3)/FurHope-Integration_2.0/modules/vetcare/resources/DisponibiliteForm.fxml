<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.DisponibiliteFormController"
      spacing="0" stylesheets="@css/app.css">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-padding: 18 28;">
        <Label fx:id="titleLabel" text="📅 Ajouter une Disponibilité"
               style="-fx-font-size: 20; -fx-font-weight: bold;"/>
            <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Back" onAction="#onBackAccueil"
                style="-fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 14;"/></HBox>

    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" style="-fx-padding: 30;">
        <VBox spacing="16" maxWidth="460"
              style="-fx-background-radius: 16; -fx-padding: 28;">

            <!-- Date -->
            <VBox spacing="6">
                <Label text="📆 Date"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <DatePicker fx:id="dateField" maxWidth="Infinity"
                            style="-fx-border-radius: 8; -fx-font-size: 13;"/>
            </VBox>

            <!-- Heure début -->
            <VBox spacing="6">
                <Label text="🕐 Heure début"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8 12;">
                    <Spinner fx:id="startHourSpinner" min="0" max="23" initialValue="8"
                             editable="true" prefWidth="70"/>
                    <Label text="h" style="-fx-font-weight: bold; -fx-font-size: 15;"/>
                    <Spinner fx:id="startMinSpinner" min="0" max="59" initialValue="0"
                             editable="true" prefWidth="70"/>
                    <Label text="min" style="-fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Heure fin -->
            <VBox spacing="6">
                <Label text="🕓 Heure fin"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8 12;">
                    <Spinner fx:id="endHourSpinner" min="0" max="23" initialValue="10"
                             editable="true" prefWidth="70"/>
                    <Label text="h" style="-fx-font-weight: bold; -fx-font-size: 15;"/>
                    <Spinner fx:id="endMinSpinner" min="0" max="59" initialValue="0"
                             editable="true" prefWidth="70"/>
                    <Label text="min" style="-fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Statut -->
            <VBox spacing="6">
                <Label text="📌 Statut"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <ComboBox fx:id="statutBox" promptText="Choisir un statut"
                          prefWidth="200"
                          style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13; -fx-padding: 4 8; -fx-cursor: hand;"/>
            </VBox>

            <!-- Boutons -->
            <HBox spacing="10" style="-fx-padding-top: 6;">
                <Button fx:id="saveButton" text="✅ Ajouter" onAction="#onSave"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 13; -fx-padding: 11 0; -fx-cursor: hand;"/>
                <Button text="📋 Liste" onAction="#onGoList"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 13; -fx-padding: 11 0; -fx-cursor: hand;"/>
                <Button text="🏠 Dashboard" onAction="#onGoHome"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 13; -fx-padding: 11 0; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </VBox>
</VBox>



