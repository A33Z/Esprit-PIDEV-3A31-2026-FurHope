<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.RendezvousFormController"
      spacing="0" stylesheets="@css/app.css">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-padding: 16 24;">
        <Label fx:id="titleLabel" text="📋 Prendre un Rendez-vous"
               style="-fx-font-size: 20; -fx-font-weight: bold;"/>
    </HBox>

    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" style="-fx-padding: 30;">
        <VBox spacing="16" maxWidth="520"
              style="-fx-background-radius: 16; -fx-padding: 28;">

            <!-- Vétérinaire -->
            <Label fx:id="vetLabel" text="👨‍⚕️ Vétérinaire : "
                   style="-fx-font-size: 15; -fx-font-weight: bold;"/>

            <!-- Erreur -->
            <Label fx:id="errorLabel"
                   style="-fx-font-size: 13;"/>

            <!-- Disponibilité -->
            <VBox spacing="6">
                <Label text="📅 Disponibilité"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <ComboBox fx:id="disponibiliteBox" promptText="Choisir une disponibilité"
                          maxWidth="Infinity"
                          style="-fx-border-radius: 8;"/>
            </VBox>

            <!-- Animal -->
            <VBox spacing="6">
                <Label text="🐾 Nom de l'animal"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <TextField fx:id="animalNomField" promptText="Ex: Minou"
                           style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13; -fx-padding: 8;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="🐶 Type d'animal"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <ComboBox fx:id="animalTypeBox" maxWidth="Infinity"
                          style="-fx-border-radius: 8;"/>
            </VBox>

            <!-- Téléphone -->
            <VBox spacing="6">
                <Label text="📞 Votre numéro de téléphone"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <TextField fx:id="numField" promptText="Ex: 21612345678"
                           style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13; -fx-padding: 8;"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="6">
                <Label text="📝 Description"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <TextArea fx:id="descriptionArea" prefRowCount="3"
                          promptText="Motif du rendez-vous"
                          style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13;"/>
            </VBox>

            <!-- Boutons -->
            <HBox spacing="10" style="-fx-padding-top: 6;">
                <Button text="🔄 Actualiser" onAction="#onRefreshDisponibilites"
                        style="-fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 10 16;"/>
                <Button fx:id="saveButton" text="✅ Ajouter" onAction="#onSave"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 10 16;"/>
                <Button text="🏠 Retour" onAction="#onGoHome"
                        style="-fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 10 16;"/>
            </HBox>

        </VBox>
    </VBox>
</VBox>



