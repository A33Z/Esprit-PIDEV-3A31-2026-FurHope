<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterDisponibilite" stylesheets="@css/app.css">
    <children>
        <!-- ID vétérinaire -->
        <TextField fx:id="vetIdTF" layoutX="50.0" layoutY="50.0" promptText="ID Vétérinaire" />
        <Label layoutX="50.0" layoutY="25.0" text="ID Vétérinaire" />

        <!-- Nom vétérinaire -->
        <TextField fx:id="vetNomTF" layoutX="300.0" layoutY="50.0" promptText="Nom Vétérinaire" />
        <Label layoutX="300.0" layoutY="25.0" text="Nom Vétérinaire" />

        <!-- Heure début -->
        <TextField fx:id="startTimeTF" layoutX="50.0" layoutY="120.0" promptText="Heure Début" />
        <Label layoutX="50.0" layoutY="95.0" text="Heure Début" />

        <!-- Heure fin -->
        <TextField fx:id="endTimeTF" layoutX="50.0" layoutY="190.0" promptText="Heure Fin" />
        <Label layoutX="50.0" layoutY="165.0" text="Heure Fin" />

        <!-- Statut -->
        <ComboBox fx:id="statutCB" layoutX="50.0" layoutY="260.0" prefWidth="150.0" promptText="Statut" />
        <Label layoutX="50.0" layoutY="235.0" text="Statut" />

        <!-- Bouton enregistrer -->
        <Button layoutX="50.0" layoutY="320.0" mnemonicParsing="false" onAction="#save" prefHeight="33.0" prefWidth="104.0" text="SAVE" textFill="RED" />

        <!-- Bouton naviguer -->
        <Button layoutX="500.0" layoutY="340.0" mnemonicParsing="false" onAction="#naviguer" text=">" />
    </children>
</AnchorPane>


