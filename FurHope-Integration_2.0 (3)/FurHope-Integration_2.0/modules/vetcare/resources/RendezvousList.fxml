<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.RendezvousListController"
      spacing="0" stylesheets="@css/app.css">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-padding: 18 28;">
        <Label text="📋 Gestion des Rendez-vous"
               style="-fx-font-size: 22; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Back" onAction="#onBackAccueil"
                style="-fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 7 18;"/>
        <Button text="🏠 Dashboard" onAction="#onBackHome"
                style="-fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 7 18;"/>
    </HBox>

    <!-- Filtre -->
    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-padding: 12 24; -fx-border-width: 0 0 1 0;">
        <Label text="Filtrer :"
               style="-fx-font-weight: bold; -fx-font-size: 13;"/>
        <ComboBox fx:id="filterBox" prefWidth="180"
                  style="-fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13;"/>
        <Button text="🔄 Actualiser" onAction="#onRefresh"
                style="-fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 7 16; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Cartes scrollables -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="cardsContainer" spacing="14"
              style="-fx-padding: 20;"/>
    </ScrollPane>

</VBox>


