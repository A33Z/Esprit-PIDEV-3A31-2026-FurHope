<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.HomeController"
      alignment="CENTER" spacing="24"
      style="-fx-padding: 50;" stylesheets="@css/app.css">

    <!-- Titre -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="🐾 Clinique Vétérinaire"
               style="-fx-font-size: 38; -fx-font-weight: bold;"/>
        <Label text="Bienvenue sur votre espace de santé animale"
               style="-fx-font-size: 14;"/>
    </VBox>

    <HBox style="-fx-min-height: 2;" maxWidth="400"/>

    <!-- Espace Vétérinaire -->
    <VBox alignment="CENTER" spacing="8">
        <Label text="👨‍⚕️ Vétérinaires"
               style="-fx-font-size: 13; -fx-font-style: italic;"/>
        <Button text="🔐 Espace Vétérinaire" onAction="#goLogin"
                style="-fx-font-size: 15; -fx-background-radius: 12; -fx-padding: 14 40; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </VBox>

    <!-- Espace Client -->
    <VBox alignment="CENTER" spacing="8">
        <Label text="👤 Clients"
               style="-fx-font-size: 13; -fx-font-style: italic;"/>
        <Button text="👤 Espace Client" onAction="#goLoginClient"
                style="-fx-font-size: 15; -fx-background-radius: 12; -fx-padding: 14 40; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </VBox>

</VBox>



