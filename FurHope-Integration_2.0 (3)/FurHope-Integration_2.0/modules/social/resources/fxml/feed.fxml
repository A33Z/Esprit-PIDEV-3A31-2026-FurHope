<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.esprit.furhope.controllers.feedcontroller" styleClass="feed-root" stylesheets="@../css/app.css">
    <HBox fx:id="feedContentRow" styleClass="feed-content-row" spacing="18" fillHeight="true" StackPane.alignment="TOP_CENTER">
        <ScrollPane fx:id="feedScrollPane" styleClass="feed-scroll" fitToWidth="true" HBox.hgrow="ALWAYS">
            <VBox fx:id="postsbox" styleClass="feed-posts-box" spacing="16">
                <padding>
                    <Insets top="14" right="16" bottom="92" left="16"/>
                </padding>
            </VBox>
        </ScrollPane>

        <ScrollPane fx:id="funScrollPane" styleClass="fun-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    minWidth="300" prefWidth="340" maxWidth="360">
            <VBox fx:id="funPanelBox" styleClass="fun-panel-box" spacing="12">
                <padding>
                    <Insets top="14" right="14" bottom="20" left="6"/>
                </padding>

                <Label text="Fun Zone" styleClass="fun-panel-title"/>
                <Label text="Free APIs, instant breaks between posts." styleClass="fun-panel-subtitle"/>

                <VBox styleClass="fun-card" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Joke of the Day" styleClass="fun-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="newJokeBtn" text="New Joke" styleClass="composer-btn-secondary" onAction="#onNewJokeClick"/>
                    </HBox>
                    <Label fx:id="jokeContentLabel" text="Tap New Joke to load." wrapText="true" styleClass="fun-card-content"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ProgressIndicator fx:id="jokeLoadingIndicator" prefWidth="16" prefHeight="16" visible="false" managed="false"/>
                        <Label fx:id="jokeErrorLabel" styleClass="fun-card-error" visible="false" managed="false" wrapText="true"/>
                    </HBox>
                </VBox>

                <VBox styleClass="fun-card" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Quote of the Day" styleClass="fun-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="newQuoteBtn" text="New Quote" styleClass="composer-btn-secondary" onAction="#onNewQuoteClick"/>
                    </HBox>
                    <Label fx:id="quoteContentLabel" text="Tap New Quote to load." wrapText="true" styleClass="fun-card-content"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ProgressIndicator fx:id="quoteLoadingIndicator" prefWidth="16" prefHeight="16" visible="false" managed="false"/>
                        <Label fx:id="quoteErrorLabel" styleClass="fun-card-error" visible="false" managed="false" wrapText="true"/>
                    </HBox>
                </VBox>

                <VBox styleClass="fun-card" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Cat Fact" styleClass="fun-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="newCatFactBtn" text="New Fact" styleClass="composer-btn-secondary" onAction="#onNewCatFactClick"/>
                    </HBox>
                    <Label fx:id="catFactContentLabel" text="Tap New Fact to load." wrapText="true" styleClass="fun-card-content"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ProgressIndicator fx:id="catFactLoadingIndicator" prefWidth="16" prefHeight="16" visible="false" managed="false"/>
                        <Label fx:id="catFactErrorLabel" styleClass="fun-card-error" visible="false" managed="false" wrapText="true"/>
                    </HBox>
                </VBox>

                <VBox styleClass="fun-card" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Random Dog" styleClass="fun-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="newDogBtn" text="New Dog" styleClass="composer-btn-secondary" onAction="#onNewDogClick"/>
                    </HBox>
                    <StackPane fx:id="dogImageContainer" styleClass="fun-image-wrap" prefHeight="190" minHeight="190">
                        <ImageView fx:id="dogImageView" fitWidth="280" fitHeight="180" preserveRatio="true"/>
                        <Label fx:id="dogPlaceholderLabel" text="Tap New Dog to load." styleClass="fun-image-placeholder"/>
                    </StackPane>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ProgressIndicator fx:id="dogLoadingIndicator" prefWidth="16" prefHeight="16" visible="false" managed="false"/>
                        <Label fx:id="dogErrorLabel" styleClass="fun-card-error" visible="false" managed="false" wrapText="true"/>
                    </HBox>
                </VBox>

                <VBox styleClass="fun-card" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Meme Drop" styleClass="fun-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="newMemeBtn" text="New Meme" styleClass="composer-btn-secondary" onAction="#onNewMemeClick"/>
                    </HBox>
                    <Label fx:id="memeTitleLabel" text="Tap New Meme to load." wrapText="true" styleClass="fun-card-content"/>
                    <StackPane fx:id="memeImageContainer" styleClass="fun-image-wrap" prefHeight="190" minHeight="190">
                        <ImageView fx:id="memeImageView" fitWidth="280" fitHeight="180" preserveRatio="true"/>
                        <Label fx:id="memePlaceholderLabel" text="Waiting for meme..." styleClass="fun-image-placeholder"/>
                    </StackPane>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ProgressIndicator fx:id="memeLoadingIndicator" prefWidth="16" prefHeight="16" visible="false" managed="false"/>
                        <Label fx:id="memeErrorLabel" styleClass="fun-card-error" visible="false" managed="false" wrapText="true"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>

    <Button fx:id="addPostFab" styleClass="fab-post" onAction="#onNewPostClick" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets right="20" bottom="22"/>
        </StackPane.margin>
    </Button>
</StackPane>
