<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16"
      alignment="TOP_CENTER"
      fillWidth="true"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.UserAdminController"
      stylesheets="@styles.css"
      styleClass="modern-ui page">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="User Management" styleClass="title" />
    <Label text="Block, activate, or delete user accounts." styleClass="subtitle" />

    <FlowPane hgap="10" vgap="10" alignment="CENTER" prefWrapLength="900">
        <TextField fx:id="searchField" promptText="Recherche (nom, email, role...)" prefWidth="360" minWidth="220"/>
        <ComboBox fx:id="sortCombo" prefWidth="190" minWidth="170" onAction="#applyFilters"/>
    </FlowPane>

    <ScrollPane fitToWidth="true"
                maxWidth="1.7976931348623157E308"
                prefHeight="460"
                styleClass="hotel-scroll-pane"
                VBox.vgrow="ALWAYS">
        <content>
            <FlowPane fx:id="userCardsPane"
                      hgap="14"
                      vgap="14"
                      prefWrapLength="980"
                      maxWidth="1.7976931348623157E308"/>
        </content>
    </ScrollPane>

    <FlowPane hgap="12" vgap="12" alignment="CENTER">
        <Button text="Refresh" styleClass="secondary-button action-button" onAction="#refreshTable"/>
        <Button text="Back" styleClass="secondary-button action-button" onAction="#goBack"/>
    </FlowPane>

</VBox>

