<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ReclamationController"
            stylesheets="@styles.css"
            styleClass="modern-ui page reclamation-page">

    <top>
        <VBox spacing="8" styleClass="card reclamation-header-card" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>
            <Label text="Client Reclamation" styleClass="title"/>
            <Label text="Create, update, and follow support tickets with a clear workflow."
                   styleClass="subtitle"
                   wrapText="true"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="18" maxWidth="1420" alignment="TOP_CENTER" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="18" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="12" prefWidth="430" minWidth="360" styleClass="card reclamation-form-card">
                <Label text="Ticket Form" styleClass="card-title"/>

                <VBox spacing="6">
                    <Label text="Sujet" styleClass="field-label"/>
                    <TextField fx:id="sujetField" promptText="Sujet" />
                </VBox>

                <VBox spacing="6">
                    <Label text="Status" styleClass="field-label"/>
                    <ComboBox fx:id="statusCombo" />
                </VBox>

                <VBox spacing="6">
                    <Label text="Description" styleClass="field-label"/>
                    <TextArea fx:id="descriptionArea" promptText="Describe the problem" prefHeight="180" wrapText="true"/>
                </VBox>

                <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                    <Button text="Add" styleClass="primary-button action-button" onAction="#addReclamation"/>
                    <Button text="Update" styleClass="primary-button action-button" onAction="#updateReclamation"/>
                    <Button text="Delete" styleClass="secondary-button action-button" onAction="#deleteReclamation"/>
                    <Button text="Responses" styleClass="secondary-button action-button" onAction="#openResponses"/>
                    <Button text="Refresh" styleClass="secondary-button action-button" onAction="#refreshTable"/>
                    <Button text="Back" styleClass="secondary-button action-button" onAction="#goBack"/>
                </FlowPane>
            </VBox>

            <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="card reclamation-list-card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Search by sujet, status, client..." HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="sortCombo" onAction="#applyFilters" prefWidth="190"/>
                </HBox>

                <ScrollPane fitToWidth="true"
                            styleClass="hotel-scroll-pane"
                            maxWidth="1.7976931348623157E308"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="reclamationCardsPane"
                                  hgap="12"
                                  vgap="12"
                                  prefWrapLength="900"
                                  maxWidth="1.7976931348623157E308"/>
                    </content>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>

</BorderPane>

