<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="modern-ui page dashboard-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">

    <left>
        <VBox spacing="14" fillWidth="true" styleClass="sidebar dashboard-sidebar" prefWidth="280" minWidth="250">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16" />
            </padding>

            <Label styleClass="sidebar-title" text="FurHope" />
            <Label styleClass="sidebar-subtitle" text="Shelter Operations" />

            <Separator />

            <Button fx:id="reclamationButton" maxWidth="1.7976931348623157E308" onAction="#openReclamation" styleClass="sidebar-button" text="Client Reclamation" />
            <Button fx:id="adminButton" maxWidth="1.7976931348623157E308" onAction="#goToAdmin" styleClass="sidebar-button" text="Vet Approvals" />
            <Button fx:id="usersButton" maxWidth="1.7976931348623157E308" onAction="#goToUserAdmin" styleClass="sidebar-button" text="User Management" />
            <Button fx:id="profileButton" maxWidth="1.7976931348623157E308" onAction="#goToProfile" styleClass="sidebar-button" text="My Profile" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator />
            <Button maxWidth="1.7976931348623157E308" onAction="#logout" styleClass="secondary-button" text="Logout" />
            <Button maxWidth="1.7976931348623157E308" onAction="#goBack" styleClass="ghost-button" text="Back" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="modern-ui page-scroll dashboard-scroll">
            <content>
                <VBox spacing="20" styleClass="dashboard-content dashboard-shell" maxWidth="1.7976931348623157E308">
                    <padding>
                        <Insets bottom="28" left="26" right="26" top="22" />
                    </padding>

                    <VBox spacing="8" styleClass="card dashboard-hero dashboard-hero-card">
                        <Label fx:id="welcomeLabel" styleClass="title dashboard-hero-title" />
                        <Label styleClass="subtitle" text="Control reclamations, approvals, and communication from one workspace." wrapText="true" />
                    </VBox>

                    <HBox alignment="TOP_LEFT" spacing="22" styleClass="dashboard-module-grid">
                        <VBox spacing="10" styleClass="dashboard-card dashboard-module-card" prefWidth="420" minWidth="340" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Reclamations" />
                            <Label styleClass="card-subtitle" text="Track issues, follow responses, and close loops quickly." wrapText="true" />
                            <Button onAction="#openReclamation" styleClass="primary-button" text="Open Reclamations" />
                        </VBox>

                        <VBox spacing="10" styleClass="dashboard-card dashboard-module-card" prefWidth="420" minWidth="340" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Admin Desk" />
                            <Label styleClass="card-subtitle" text="Approve veterinarians and manage user permissions." wrapText="true" />
                            <Button onAction="#goToAdmin" styleClass="secondary-button" text="Open Admin" />
                        </VBox>

                        <VBox spacing="10" styleClass="dashboard-card dashboard-module-card" prefWidth="420" minWidth="340" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Profile" />
                            <Label styleClass="card-subtitle" text="Update your identity, contact details, and profile image." wrapText="true" />
                            <Button onAction="#goToProfile" styleClass="secondary-button" text="Edit Profile" />
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>

