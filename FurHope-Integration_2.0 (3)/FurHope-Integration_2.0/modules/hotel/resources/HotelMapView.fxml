<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.HotelMapController"
            styleClass="user-page"
            stylesheets="@AppTheme.css"
            prefHeight="760.0" prefWidth="1080.0">
    <children>
        <VBox styleClass="page-content" spacing="10.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label fx:id="mapTitleLabel" text="Hotel Map" styleClass="header-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Close" styleClass="button ghost-button" onAction="#handleClose" />
                </children>
            </HBox>
            <Label fx:id="mapMessageLabel" text="" styleClass="header-subtitle" />
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <children>
                    <WebView fx:id="mapWebView" VBox.vgrow="ALWAYS" />
                </children>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
